{
  "__inputs": [
    {
      "name": "DS_DEUCEX",
      "label": "DeuceX Postgres (read-only)",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "title": "DeuceX agent health",
  "uid": "deucex-agent-health",
  "tags": ["deucex"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1h",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "description": "From agent_health_daily, the nightly aggregation (02:00 UTC). The admin console's Agent health page shows the same table; this is the longer-range view PRD-13 links out to.",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Runs per day",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_DEUCEX}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_DEUCEX}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select day::timestamp as time, agent as metric, runs as value from agent_health_daily where $__timeFilter(day::timestamp) order by 1"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Success rate",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_DEUCEX}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_DEUCEX}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select day::timestamp as time, agent as metric, success_rate::float as value from agent_health_daily where $__timeFilter(day::timestamp) order by 1"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency p95 (ms)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_DEUCEX}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_DEUCEX}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select day::timestamp as time, agent as metric, p95_ms as value from agent_health_daily where $__timeFilter(day::timestamp) order by 1"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Model spend per day (USD)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_DEUCEX}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_DEUCEX}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select day::timestamp as time, agent as metric, cost_total::float as value from agent_health_daily where $__timeFilter(day::timestamp) order by 1"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Approval rate, rolling 7 days (alert under 30%)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_DEUCEX}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto",
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_DEUCEX}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select day::timestamp as time, agent as metric, approval_rate_7d::float as value from agent_health_daily where $__timeFilter(day::timestamp) order by 1"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Dismiss rate, rolling 7 days",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_DEUCEX}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_DEUCEX}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select day::timestamp as time, agent as metric, dismiss_rate_7d::float as value from agent_health_daily where $__timeFilter(day::timestamp) order by 1"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Model spend this month, all agents (USD)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_DEUCEX}"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_DEUCEX}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select coalesce(sum(cost_total), 0)::float as value from agent_health_daily where day >= date_trunc('month', now())::date"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Yesterday by agent",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_DEUCEX}"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_DEUCEX}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select agent, runs, round(success_rate::numeric * 100, 1) as success_pct, p95_ms, round(cost_total::numeric, 4) as cost_usd, round(approval_rate_7d::numeric * 100, 1) as approval_pct_7d from agent_health_daily where day = (select max(day) from agent_health_daily) order by agent"
        }
      ]
    }
  ]
}
