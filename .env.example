# Supabase project: ProCircuit (gpzpmrumwaqyfkyvqbgl, org MD Labs, ap-northeast-1)
SUPABASE_URL=https://gpzpmrumwaqyfkyvqbgl.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=gpzpmrumwaqyfkyvqbgl
# Direct Postgres connection (Project Settings > Database > Connection string).
# Only needed to run packages/db's RLS integration tests locally; CI does not set it.
SUPABASE_DB_URL=

# apps/web (browser-exposed, so NEXT_PUBLIC_* — publishable key only, never the service role key)
NEXT_PUBLIC_SUPABASE_URL=https://gpzpmrumwaqyfkyvqbgl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# apps/api's own base URL, for the Match Scribe upload/save/delete/retry
# calls that have to go through it (R2, Whisper) — see apps/web/lib/match-scribe/api.ts.
NEXT_PUBLIC_API_URL=http://localhost:8787

# apps/api
PORT=8787
CORS_ORIGIN=http://localhost:3000
# Server-side Supabase keys apps/api needs directly (service role bypasses RLS;
# only ever used server-side, never shipped to the browser).
SUPABASE_ANON_KEY=

# Vendors (wired up as each build step needs them; test mode only until launch)
STRIPE_SECRET_KEY=
# Step 2.3: account-deletion confirmation and data-export delivery emails.
# Without it, apps/api falls back to a logging mock (see apps/api/src/index.ts) —
# the flow still runs, but no real email is sent.
RESEND_API_KEY=
# Optional: defaults to Resend's own sandbox sender (onboarding@resend.dev),
# which needs no domain verification. Set this once procircuit.app (or
# another real domain) is verified in Resend — see resend.com/domains. A
# real send attempt against the unverified domain fails with a 403, found
# live while building step 2.3.
RESEND_FROM_ADDRESS=
# Where apps/web is actually reachable, so the deletion-confirm link Resend
# emails resolves. Defaults to http://localhost:3000 in dev.
APP_BASE_URL=http://localhost:3000

# Match Scribe (step 1.1): Cloudflare R2 for audio, OpenAI Whisper for
# transcription. Without these, apps/api falls back to an in-memory storage
# adapter and a mock transcription adapter (see apps/api/src/index.ts) so
# `pnpm dev:api` still runs, but audio does not survive a restart and
# transcripts are a fixed fixture, not real speech-to-text.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=procircuit-notes-audio
# Also match-scribe/extract's structured extraction (step 1.2, gpt-4o-mini) —
# one OpenAI account for both Whisper and extraction. Without it, both fall
# back to a mock (see apps/api/src/index.ts): transcripts are a fixed
# fixture and every note gets the same fixed extraction proposal, not a real
# reading of its transcript.
OPENAI_API_KEY=
