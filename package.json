{
  "name": "deucex",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "pnpm -r --if-present run test",
    "test:e2e": "playwright test",
    "dev:web": "pnpm --filter @deucex/web dev",
    "dev:admin": "pnpm --filter @deucex/admin dev",
    "dev:api": "pnpm --filter @deucex/api dev",
    "dev:sign-in-link": "node scripts/dev-sign-in-link.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  }
}
